{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Options shared by the library build (tsconfig.lib.json), plus the
  // project-references entry point so `tsc --build` works from the root.
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowJs": false,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["vite/client"],
    "paths": {}
  },
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    },
    {
      "path": "./tsconfig.scripts.json"
    }
  ],
  "extends": "./tsconfig.base.json"
}
